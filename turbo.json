{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "env": ["NEXT_PUBLIC_API_URL", "NEXT_PUBLIC_RELAYER_URL"],
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "check": {
      "dependsOn": ["^check"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "cache": false,
      "passThroughEnv": ["ENROLLMENT_TEST_DATABASE_URL", "DEPLOYMENT_TEST_RPC_URL"],
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
