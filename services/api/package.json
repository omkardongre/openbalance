{
  "name": "@openbalance/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./account-access": {
      "types": "./src/account-access.ts",
      "default": "./dist/account-access.js"
    },
    "./deployment-chain": {
      "types": "./src/deployment-chain.ts",
      "default": "./dist/deployment-chain.js"
    },
    "./deployments": {
      "types": "./src/deployments.ts",
      "default": "./dist/deployments.js"
    },
    "./enrollment": {
      "types": "./src/enrollment.ts",
      "default": "./dist/enrollment.js"
    },
    "./operations": {
      "types": "./src/operations.ts",
      "default": "./dist/operations.js"
    },
    "./sponsorship": {
      "types": "./src/sponsorship.ts",
      "default": "./dist/sponsorship.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.2.0",
    "@openbalance/protocol": "workspace:*",
    "@simplewebauthn/server": "14.0.1",
    "fastify": "5.12.3",
    "pg": "8.23.0",
    "viem": "2.56.3",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
