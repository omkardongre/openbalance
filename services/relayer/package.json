{
  "name": "@openbalance/relayer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "migrations",
    "package.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "dev": "tsx watch src/server.ts",
    "migrate": "tsx src/migrate.ts",
    "provision:vendor-treasury": "tsx src/provision-vendor-treasury.ts",
    "start": "node dist/server.js",
    "start:financial-worker": "node dist/financial-worker-server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.2.0",
    "@openbalance/api": "workspace:*",
    "@openbalance/observability": "workspace:*",
    "@openbalance/protocol": "workspace:*",
    "fastify": "5.12.3",
    "pg": "8.23.0",
    "viem": "2.56.3",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@types/pg": "8.23.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
