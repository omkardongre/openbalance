FROM node:24.21.0-bookworm-slim@sha256:2fe369e969550cde8e867afc3fe370b260140cab4a23d467074295b42163d553 AS build
WORKDIR /source
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_RELAYER_URL
ARG NEXT_PUBLIC_FINANCIAL_RPC_URL
ARG NEXT_PUBLIC_WEBAUTHN_RP_ID
RUN npm install --global pnpm@12.3.4
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm exec turbo run build --filter="@openbalance/web"

FROM node:24.21.0-bookworm-slim@sha256:2fe369e969550cde8e867afc3fe370b260140cab4a23d467074295b42163d553 AS runtime
ENV NODE_ENV=production HOSTNAME=0.0.0.0 PORT=3000
WORKDIR /app
COPY --from=build --chown=node:node /source/apps/web/.next/standalone/ ./
COPY --from=build --chown=node:node /source/apps/web/.next/static/ ./apps/web/.next/static/
COPY --from=build --chown=node:node /source/apps/web/public/ ./apps/web/public/
USER node
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
