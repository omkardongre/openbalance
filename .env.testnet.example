# Template for the Monad testnet environment. Copy to .env.testnet (gitignored) and fill in real
# values. This file is committed, so it must never contain a real credential.
#
# This environment is separate from the local Anvil/Docker-Postgres harness (§5.3): distinct
# manifest, database, and keys, so a mistake here cannot touch local development state.

# --- Monad testnet RPC (QuickNode, Metropolis hackathon perk) ---
ACCOUNT_RPC_URL=
ACCOUNT_FINALITY_TAG=finalized

# --- Independent second RPC provider for the verifier (§3.5) ---
# Must be a genuinely different provider, not a second URL from the same one.
VERIFIER_RPC_URL=

# --- Database (managed Postgres, Neon) ---
# Pin the port explicitly (Neon serves 5432). Debian/Ubuntu ship /usr/bin/psql as the
# postgresql-common pg_wrapper script, which substitutes the local default cluster's port whenever
# the connection string omits one — a portless URL then dials the wrong port and hangs instead of
# failing. Neon's published connection string omits the port, so add it.
DATABASE_URL=

# --- Testnet contract deployer ---
# Use an encrypted keystore, never a raw private key file, for the deployment signer:
#   cast wallet new ./secrets/testnet testnet-deployer
# Both paths must be mode 0600 and live under the gitignored secrets/ tree.
DEPLOYER_KEYSTORE_PATH=
DEPLOYER_KEYSTORE_PASSWORD_FILE=

# --- Optional testnet deployment overrides ---
# Settlement asset defaults to Circle's published Monad testnet USDC and is confirmed on chain
# (bytecode present, 6 decimals, USDC symbol) before use. Override only to test against a different
# asset. The event label is hashed to derive the event ID, so changing it deploys a distinct event.
TESTNET_ASSET_ADDRESS=
TESTNET_EVENT_LABEL=
TESTNET_RISK_OPERATOR=
TESTNET_MAXIMUM_FEE_BPS=

# --- Manifests (produced by `testnet:manifest`, never hand-written) ---
# These bind each address to the hash of the bytecode running at it, re-checked at the finalized tag
# on every use. Regenerate with `testnet:manifest`; editing them by hand defeats the binding.
ACCOUNT_MANIFEST_PATH=./deployments/testnet/account-manifest.json
FINANCIAL_EVENT_MANIFEST_PATH=./deployments/testnet/financial-manifest.json

# --- Envio HyperSync (indexer primary log source, Envio bounty) ---
# Free token from https://envio.dev/app/api-tokens (sign in, enable HyperSync, create a token).
# HyperSync rejects requests without one (HTTP 401). Keep the real value only in .env.testnet.
ENVIO_API_TOKEN=
