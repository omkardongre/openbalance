{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "files": {
    "includes": [
      "**",
      "!!**/.next",
      "!!**/.turbo",
      "!!**/coverage",
      "!!**/build",
      "!!apps/terminal-android/app/schemas",
      "!!packages/sdk/src/generated",
      "!!**/dist",
      "!!contracts/out",
      "!!contracts/cache",
      "!!out",
      "!!cache",
      "!!**/node_modules"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
