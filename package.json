{
  "name": "openbalance",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": ">=12.3.4 <13"
  },
  "scripts": {
    "android:build": "./apps/terminal-android/gradlew -p apps/terminal-android :app:testDebugUnitTest :app:assembleDebug",
    "api:generate": "node scripts/generate-api-types.mjs",
    "coverage:contracts": "node scripts/foundry.mjs forge coverage --root contracts --ir-minimum --report summary",
    "evidence:local": "node scripts/local-evidence.mjs",
    "images:publish": "node scripts/publish-images.mjs",
    "evidence:package": "node scripts/package-evidence.mjs",
    "sbom": "node scripts/generate-sbom.mjs evidence/sbom.cdx.json",
    "verify:faucet": "node scripts/verify-faucet-scenario.mjs",
    "verify:postgres": "node scripts/verify-postgres.mjs",
    "verify:relay": "node scripts/verify-relay-scenario.mjs",
    "verify:scenario": "node scripts/verify-scenario.mjs",
    "verify:system": "node scripts/verify-system-scenario.mjs",
    "verify:local": "node scripts/verify-local-system.mjs",
    "verify:remote-config": "node scripts/verify-remote-config.mjs",
    "verify:local-chain": "node scripts/verify-local-chain.mjs",
    "testnet:preflight": "node scripts/deploy-testnet.mjs preflight",
    "testnet:deploy": "node scripts/deploy-testnet.mjs deploy",
    "testnet:manifest": "node scripts/deploy-testnet.mjs manifest",
    "testnet:verify": "node scripts/deploy-testnet.mjs verify",
    "testnet:provision-event": "node scripts/provision-testnet-event.mjs",
    "test:tooling": "node --test scripts/*.test.mjs",
    "workload": "node scripts/run-payment-workload.mjs",
    "workload:slo": "node scripts/slo-workload.mjs",
    "build": "turbo run build && node scripts/foundry.mjs forge build --root contracts",
    "check": "biome check . && turbo run check && node scripts/foundry.mjs forge fmt --root contracts --check",
    "dev": "turbo run dev",
    "prepare": "husky || true",
    "test": "node --test scripts/*.test.mjs && turbo run test && node scripts/foundry.mjs forge test --root contracts",
    "verify:release": "pnpm check && pnpm test && pnpm build && pnpm coverage:contracts && pnpm run sbom"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@openzeppelin/contracts": "5.6.1",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "turbo": "2.10.12",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  }
}
